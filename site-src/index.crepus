    div class="flex flex-col gap-1"
      span
        "darash — ISC licensed. built with rust."
      span class="text-zinc-500"
        "website built with "
        a class="hover:text-blue-500 transition-colors" href="https://github.com/tschk/crepuscularity" target="_blank" rel="noopener noreferrer"
          "crepuscularity"
        " + "
        a class="hover:text-blue-500 transition-colors" href="https://github.com/tschk/moonshine" target="_blank" rel="noopener noreferrer"
          "moonshine"
    div class="flex gap-3.5 flex-wrap"
      a class="hover:text-zinc-100 transition-colors" href="llms.txt"
        "llms.txt"
      a class="hover:text-zinc-100 transition-colors" href="https://github.com/tschk/darash"
        "source"
      a class="hover:text-zinc-100 transition-colors" href="https://crates.io/crates/darash"
        "crates.io"
      a class="hover:text-zinc-100 transition-colors" href="https://docs.rs/darash"
        "docs.rs"
