{
  "name": "darash-web",
  "main": "build/index.js",
  "compatibility_date": "2025-04-01",
  "assets": {
    "directory": "../site",
    "binding": "ASSETS"
  },
  "services": [
    { "binding": "API", "service": "darash-site" }
  ],
  "routes": [
    { "pattern": "darash.tsc.hk", "zone_name": "tsc.hk", "custom_domain": true }
  ],
  "build": {
    "command": "cargo install -q worker-build --version 0.8.6 && worker-build --release",
    "watch_dir": ["src", "../crates/moonshine-cloudflare/src"]
  },
  "observability": { "enabled": true }
}
