// Dev-only mirror of wrangler.jsonc for multi-worker local dev
// (`wrangler dev -c ../web/wrangler.jsonc -c wrangler.dev.jsonc`).
// Multi-worker dev runs secondary builds from the wrong cwd, so this config
// expects `build/index.js` to exist: run `worker-build --release` in worker/
// first. Deployments keep using wrangler.jsonc, which builds from source.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "darash-site",
  "main": "build/index.js",
  "compatibility_date": "2025-04-01",
  "assets": {
    "directory": "../site"
  },
  "durable_objects": {
    "bindings": [
      { "name": "COUNTER", "class_name": "Counter" },
      { "name": "ACCOUNTS", "class_name": "Accounts" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Counter"] },
    { "tag": "v2", "new_sqlite_classes": ["Accounts"] }
  ],
  "observability": { "enabled": true }
}
