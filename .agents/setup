#!/usr/bin/env bash
set -euo pipefail

step() {
  local started
  started="$(date +%s)"
  echo "==> $1"
  shift
  "$@"
  echo "    done in $(($(date +%s) - started))s"
}

need_pkg() {
  dpkg -s "$1" >/dev/null 2>&1
}

packages=()
for pkg in build-essential pkg-config libssl-dev curl ca-certificates; do
  if ! need_pkg "$pkg"; then
    packages+=("$pkg")
  fi
done
if ((${#packages[@]})); then
  step "apt-get update" sudo apt-get update -y
  step "install ${packages[*]}" sudo apt-get install -y "${packages[@]}"
else
  echo "==> system packages already present"
fi

export CARGO_HOME="${CARGO_HOME:-$HOME/.cargo}"
export RUSTUP_HOME="${RUSTUP_HOME:-$HOME/.rustup}"
export PATH="$CARGO_HOME/bin:$PATH"

if ! command -v rustup >/dev/null 2>&1; then
  step "install rustup" bash -c 'curl --proto "=https" --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --default-toolchain stable --profile minimal'
fi
# shellcheck disable=SC1091
source "$CARGO_HOME/env"

step "ensure stable toolchain" rustup toolchain install stable --profile minimal --component rustfmt,clippy
step "default toolchain" rustup default stable
step "fetch crate deps" cargo fetch --locked
step "build workspace" cargo build --locked --all-targets

profile_marker="# darash rust toolchain"
if ! grep -Fqx "$profile_marker" "$HOME/.bash_profile" 2>/dev/null; then
  cat >>"$HOME/.bash_profile" <<'EOF'

# darash rust toolchain
if [ -f "$HOME/.cargo/env" ]; then
  # shellcheck disable=SC1091
  . "$HOME/.cargo/env"
fi
EOF
fi

echo "==> setup complete"
rustc --version
cargo --version
